---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About - wblog" description="About me">
  <h1 class="text-3xl font-bold tracking-tight">About Me</h1>
  <div class="mt-6 prose prose-gray dark:prose-invert max-w-none">
    <p>
      Welcome to my blog! I write about software development, technology, and
      things I learn along the way.
    </p>
    <p>
      This site is built with Astro and Decap CMS, styled with Tailwind CSS, and
      deployed as a static site.
    </p>
  </div>
</BaseLayout>
