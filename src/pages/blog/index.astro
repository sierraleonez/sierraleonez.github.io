---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Blog - wblog" description="All blog posts">
  <h1 class="text-3xl font-bold tracking-tight">All Posts</h1>
  <div class="mt-8 space-y-6">
    {sortedPosts.length === 0 && <p class="text-gray-500 dark:text-gray-400">No posts yet. Check back soon!</p>}
    {sortedPosts.map(post => <BlogCard post={post} />)}
  </div>
</BaseLayout>
